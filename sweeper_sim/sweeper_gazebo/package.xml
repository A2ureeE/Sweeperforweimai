<?xml version="1.0"?>
<package format="3">
  <name>sweeper_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo worlds, cone/pedestrian/building models and spawn launch for the sweeper.</description>
  <maintainer email="dev@sweeper.local">sweeper</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros_pkgs</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sweeper_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
